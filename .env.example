# Base URL the admin dashboard (/admin/*) and the server-rendered public pages call.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# The site's own public origin (no trailing slash) — used to build absolute canonical/hreflang/
# Open Graph URLs and the sitemap. Set this to the real production domain on Hostinger.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
